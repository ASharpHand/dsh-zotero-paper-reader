{
  "name": "@local/dsh-paper-reader",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Zotero library browser and PDF reading workspace for the Harness Web UI",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/*.py",
    "vendor/**",
    "zotero-bridge/**",
    "README.md",
    "INSTALL-AGENT.md",
    "install-zotero-addon.py",
    "paper-reader-bridge.xpi"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
